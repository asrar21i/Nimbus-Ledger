{
  "resource_changes": [
    {
      "address": "aws_s3_bucket.customer_docs",
      "type": "aws_s3_bucket",
      "change": {
        "after": {
          "bucket": "nimbus-customer-docs",
          "tags": {
            "Owner": "alice",
            "DataClassification": "Confidential"
          },
          "server_side_encryption_configuration": {
            "rule": {
              "apply_server_side_encryption_by_default": {
                "sse_algorithm": "AES256"
              }
            }
          }
        }
      }
    },
    {
      "address": "aws_s3_bucket_versioning.customer_docs",
      "type": "aws_s3_bucket_versioning",
      "change": {
        "after": {
          "bucket": "nimbus-customer-docs",
          "versioning_configuration": [
            { "status": "Enabled" }
          ]
        }
      }
    },
    {
      "address": "aws_instance.app_server",
      "type": "aws_instance",
      "change": {
        "after": {
          "tags": {
            "Owner": "bob",
            "CostCenter": "eng-42"
          }
        }
      }
    },
    {
      "address": "aws_db_instance.main",
      "type": "aws_db_instance",
      "change": {
        "after": {
          "tags": {
            "Owner": "carol",
            "DataClassification": "Confidential"
          }
        }
      }
    },
    {
      "address": "aws_security_group.app_sg",
      "type": "aws_security_group",
      "change": {
        "after": {
          "ingress": [
            {
              "from_port": 22,
              "cidr_blocks": ["0.0.0.0/0"]
            },
            {
              "from_port": 443,
              "cidr_blocks": ["10.0.0.0/16"]
            }
          ]
        }
      }
    },
    {
      "address": "aws_iam_policy.admin_policy",
      "type": "aws_iam_policy",
      "change": {
        "after": {
          "policy": "{\"Statement\":[{\"Effect\":\"Allow\",\"Action\":\"iam:*\",\"Resource\":\"*\"}]}"
        }
      }
    }
  ]
}